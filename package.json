{
  "name": "dsaforge-monorepo",
  "version": "1.0.0",
  "description": "DSAForge - Interactive Data Structures & Algorithms Learning Platform",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start": "npm --prefix backend run start",
    "build": "npm --prefix frontend run build",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "seed": "npm --prefix backend run seed"
  },
  "keywords": ["dsa", "learning-platform", "visualizer", "monorepo"],
  "author": "DSAForge Team",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "mongoose": "^8.4.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
